# TiDB Cloud Connection
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<your-tidb-user>.root
TIDB_PASSWORD=<your-tidb-password>
TIDB_DATABASE=menangin
TIDB_SSL=true

# Optional: Pengiriman Email Otomatis via SMTP (Gmail App Password / Brevo / Mailtrap / dll.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Menangin! Festival <noreply@menangin.id>"

# Optional: Pengiriman WhatsApp Otomatis (fonnte | meta | webhook)
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
